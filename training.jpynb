    #include<bits/stdc++.h>
using namespace std;
#define N 1000000007
 
long long mod(long long base,long long exp,long long mod)
{
long long res;
res = 1LL;
while (exp > 0) {
if (exp % 2 == 1) {
res = (res * base) % mod;
}
base = (base * base) % mod;
exp = exp / 2;
}
return res;
}
 
int main()
{
    int t;
    cin >> t;
    while(t--) {
        long long int n;
        cin >> n;
        long long int ans = mod(2, n - 1, 1000000007);
        if(n == 1)
            cout << "0"<< endl;
        else
            cout << ans - 2 <<endl;
    }
    return 0;
}
 






